# Local-only demo Firebase project. These are emulator identifiers, not service credentials.
VELA_DATA_MODE=firebase
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000
NEXT_PUBLIC_FIREBASE_API_KEY=demo-vela-emulator-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-vela.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-vela
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-vela.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:vela-local
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=true
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_URL=http://127.0.0.1:9099
FIREBASE_PROJECT_ID=demo-vela
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
