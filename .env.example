# External-service configuration. Replace every REPLACE_WITH value before use.
# For working local development without credentials, use .env.emulator.example.
# Copy to ignored .env.local; never commit real values or service-account files.
VELA_DATA_MODE=firebase

# Exact application origin: HTTPS externally; loopback HTTP is allowed locally.
# No path, query, fragment, credentials, or surrounding whitespace.
NEXT_PUBLIC_APP_URL=https://vela.example

# Firebase Console > Project settings > your web application's configuration.
# These browser-visible identifiers and the Admin account must use the same project.
NEXT_PUBLIC_FIREBASE_API_KEY=REPLACE_WITH_FIREBASE_WEB_API_KEY
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=REPLACE_WITH_FIREBASE_AUTH_DOMAIN
NEXT_PUBLIC_FIREBASE_PROJECT_ID=REPLACE_WITH_FIREBASE_PROJECT_ID
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=REPLACE_WITH_FIREBASE_STORAGE_BUCKET
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=REPLACE_WITH_FIREBASE_MESSAGING_SENDER_ID
NEXT_PUBLIC_FIREBASE_APP_ID=REPLACE_WITH_FIREBASE_WEB_APP_ID

# Server-only Firebase Admin service account.
FIREBASE_PROJECT_ID=REPLACE_WITH_FIREBASE_PROJECT_ID
FIREBASE_CLIENT_EMAIL=REPLACE_WITH_SERVICE_ACCOUNT_EMAIL
# Paste the PEM in quotes. Both actual line breaks and escaped \n are supported.
FIREBASE_PRIVATE_KEY="REPLACE_WITH_SERVICE_ACCOUNT_PRIVATE_KEY"

# Cloudinary product environment. The cloud name is browser-visible.
# Configure the API key server-side; it is also returned in signed upload fields.
# The API secret must remain server-only and is never returned to the browser.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=REPLACE_WITH_CLOUDINARY_CLOUD_NAME
CLOUDINARY_API_KEY=REPLACE_WITH_CLOUDINARY_API_KEY
CLOUDINARY_API_SECRET=REPLACE_WITH_CLOUDINARY_API_SECRET

# Stripe sandbox/test mode only: sk_test_ secret and this endpoint's whsec_ secret.
# Hosted Checkout needs no publishable key in this application.
STRIPE_SECRET_KEY=REPLACE_WITH_SK_TEST_KEY
STRIPE_WEBHOOK_SECRET=REPLACE_WITH_WHSEC_SECRET

# Server-only reservation recovery: random, at least 32 characters, no whitespace.
# The placeholder intentionally fails the minimum length check.
CRON_SECRET=REPLACE_WITH_RANDOM_SECRET

# External environments must keep this false and omit all three hosts below.
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=false
# Local-only settings are fully defined in .env.emulator.example:
# NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_URL=http://127.0.0.1:9099
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
