{
  "name": "vela",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "format:check": "prettier --check src",
    "emulators": "firebase emulators:start --project demo-vela --only auth,firestore",
    "seed": "tsx --env-file=.env.local scripts/seed.ts",
    "admin:grant": "tsx --env-file=.env.local scripts/grant-admin.ts"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "5.3.0",
    "@fontsource/manrope": "5.3.0",
    "@gsap/react": "2.1.2",
    "@hookform/resolvers": "7.0.3",
    "@radix-ui/react-accordion": "1.3.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-slot": "1.5.0",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "@tailwindcss/postcss": "4.3.4",
    "class-variance-authority": "0.7.1",
    "cloudinary": "2.11.0",
    "clsx": "2.1.1",
    "firebase": "12.19.0",
    "firebase-admin": "14.5.0",
    "gsap": "3.15.1",
    "lucide-react": "1.69.0",
    "motion": "14.9.1",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.91.0",
    "recharts": "3.10.1",
    "server-only": "0.0.1",
    "stripe": "23.1.0",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.4",
    "three": "0.187.0",
    "zod": "4.6.7",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.2",
    "@playwright/test": "1.64.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "firebase-tools": "15.35.0",
    "jsdom": "26.1.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "5.1.0"
  }
}
