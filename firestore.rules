rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.get('admin', false) == true;
    }

    // The Admin SDK bypasses these rules. Every server mutation must separately
    // validate its input and verify the user's session/custom claims.
    match /products/{productId} {
      allow read: if resource.data.status == 'published' || isAdmin();
      allow write: if false;
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if false;
    }

    match /settings/{settingId} {
      allow get: if settingId == 'home' || isAdmin();
      allow list: if isAdmin();
      allow write: if false;
    }

    match /users/{userId} {
      allow get: if signedIn() && (request.auth.uid == userId || isAdmin());
      // A customer query must constrain the document ID to their own uid.
      allow list: if isAdmin()
        || (signedIn() && request.auth.uid == userId);
      allow write: if false;
    }

    match /orders/{orderId} {
      // Rules are not filters: customer list queries must use userId == uid.
      allow read: if signedIn()
        && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if false;
    }

    match /auditLogs/{auditId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Includes inventoryReservations, stripeWebhookEvents, rateLimits, media,
    // promotions, contactMessages, newsletterSubscribers, and future private
    // collections. They are server-only, including for administrators.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
